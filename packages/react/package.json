{
  "name": "@zemd/eslint-react",
  "version": "3.0.4",
  "license": "Apache-2.0",
  "description": "Shared ESLint config for react projects",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "eslint",
    "flat config",
    "javascript",
    "typescript",
    "react",
    "eslintconfig",
    "eslint rules"
  ],
  "author": {
    "name": "Dmytro Zelenetskyi",
    "email": "dmytro.zelenetskyi@gmail.com",
    "url": "https://zemd.dev"
  },
  "homepage": "https://github.com/zemd/eslint-flat-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemd/eslint-flat-config.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/zemd/eslint-flat-config/issues"
  },
  "files": [
    "dist"
  ],
  "funding": "https://github.com/sponsors/zemd",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "peerDependencies": {
    "eslint": ">=9.2.0 || >=10.0.0"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.17.3",
    "@typescript-eslint/parser": "8.65.0",
    "@zemd/eslint-common": "workspace:*",
    "@zemd/eslint-ts": "workspace:*",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "catalog:",
    "local-pkg": "1.2.1"
  },
  "devDependencies": {
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "@zemd/tsconfig": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsdown --minify",
    "dev": "tsdown --watch",
    "lint": "publint"
  }
}
